<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Nothing goes to cloud backup (the app's data never leaves the
    phone). Direct device-to-device transfer is allowed, so playlists and
    settings follow you to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <!-- The saved queue is a list of MediaStore IDs, which point at different files (or
         none) on another phone. Everything else may follow you. -->
    <device-transfer>
        <exclude domain="file" path="datastore/playback_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
