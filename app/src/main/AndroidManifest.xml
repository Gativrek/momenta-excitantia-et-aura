<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission, ever: the app is offline by design and nothing leaves the phone. -->

    <!-- Read the music library: READ_MEDIA_AUDIO on Android 13+, the old storage permission below. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Write tags into music files (tag editing). Android 11+ asks per batch through
        MediaStore.createWriteRequest instead and needs no permission; on Android 10 this works
        together with requestLegacyExternalStorage below.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Background playback: a foreground service of type mediaPlayback (the type permission is required on 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keep the CPU awake while playing with the screen off (ExoPlayer's WAKE_MODE_LOCAL). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+: show the playback notification. Optional, media controls work without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Momenta">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Owns the player. Exported so system UI, Bluetooth and other controllers can bind to
            its MediaSession; Media3 checks each controller in onConnect.
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The home-screen widget. Its play buttons go straight to the service as media buttons. -->
        <receiver
            android:name=".widget.NowPlayingWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget" />
        </receiver>

        <!-- The widget's Moment bolt. Only the widget sends it. -->
        <receiver
            android:name=".widget.WidgetMomentReceiver"
            android:exported="false" />

        <!-- Hands the Aura share card to the share sheet. Only the app's cache/shared folder. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

</manifest>
